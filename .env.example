# Local defaults. Copy this file to .env (Compose reads it automatically).
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
PUBLIC_ROOM_LIST=false
# Public matchmaking countdown, in milliseconds.
MATCH_START_DELAY_MS=15000
MAX_ROOMS=500
MAX_CONNECTIONS=200
EVENTS_PER_MINUTE=180
JOINS_PER_MINUTE=30
CREATES_PER_HOUR=10
CONNECTIONS_PER_MINUTE=120

# Public HTTPS server behind a reverse proxy on the host:
# ALLOWED_ORIGINS=https://games.example.com
# COOKIE_SECURE=true
# Keep BIND_ADDRESS=127.0.0.1; expose only the proxy's ports 80/443.
